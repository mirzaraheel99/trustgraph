TRUSTGRAPH_HOST=trustgraph.5-75-224-110.sslip.io
TRUSTGRAPH_HTTP_BIND=127.0.0.1
TRUSTGRAPH_HTTP_PORT=4180
TRUSTGRAPH_HTTPS_BIND=127.0.0.1
TRUSTGRAPH_HTTPS_PORT=4443
POSTGRES_DB=trustgraph
POSTGRES_USER=trustgraph
POSTGRES_HOST_PORT=15432
POSTGRES_PASSWORD=replace-with-a-long-random-password
TRUSTGRAPH_SESSION_TTL_SECONDS=1209600

# VPS launch auth provider. Use postgres on the VPS so account create/login use the local Postgres auth API.
NEXT_PUBLIC_AUTH_PROVIDER=postgres

# Optional legacy Supabase settings. Leave blank when NEXT_PUBLIC_AUTH_PROVIDER=postgres.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
